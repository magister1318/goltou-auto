{
  "name": "goltou-auto",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.11.0",
  "engines": { "node": ">=18.20.4" },
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc -p apps/android/bridge/tsconfig.json",
    "test": "vitest run",
    "build": "node scripts/build-core.mjs",
    "sim": "pnpm build && node scripts/simulate.mjs",
    "sim:check": "pnpm build && node scripts/simulate.mjs --check",
    "sim:shots": "pnpm build && node scripts/simulate.mjs --shots",
    "android:libnode": "node apps/android/scripts/fetch-libnode.mjs"
  },
  "devDependencies": {
    "@types/node": "18.19.100",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.5",
    "playwright-core": "1.56.1",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.1.4",
    "ws": "8.18.3"
  },
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] }
}
